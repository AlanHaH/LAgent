  <diagram id="recommended-flow" name="建议主流程">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="1200">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="建议：收敛为一条学习闭环" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#173d31;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="3" value="知识库、问答和项目都作为主流程的工具或成果形态，不再与学习主线平级。" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="850" height="30" as="geometry" />
        </mxCell>

        <mxCell id="4" value="一次性设置" style="swimlane;startSize=32;fillColor=#f5f5f5;strokeColor=#9e9e9e;fontStyle=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="300" height="300" as="geometry" />
        </mxCell>
        <mxCell id="5" value="学习方向 + 当前水平&#xa;每周可用时间 + 偏好" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="4">
          <mxGeometry x="40" y="70" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="6" value="可选：基线诊断&#xa;建立初始掌握度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="4">
          <mxGeometry x="50" y="190" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="7" value="定义结果" style="swimlane;startSize=32;fillColor=#f5f5f5;strokeColor=#9e9e9e;fontStyle=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="390" y="140" width="300" height="300" as="geometry" />
        </mxCell>
        <mxCell id="8" value="创建一个目标&#xa;日期、预算、可勾选成功标准" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="7">
          <mxGeometry x="40" y="70" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="9" value="可选成果形态&#xa;课程型 / 项目型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="7">
