        </mxCell>

        <mxCell id="4" value="1. 账户与画像" style="swimlane;startSize=34;horizontal=0;fillColor=#f5f5f5;strokeColor=#9e9e9e;fontStyle=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="300" height="760" as="geometry" />
        </mxCell>
        <mxCell id="5" value="注册 / 登录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="4">
          <mxGeometry x="70" y="60" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="6" value="画像访谈或手动填写&#xa;方向、阶段、日期、可用时间" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="4">
          <mxGeometry x="50" y="180" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7" value="生成画像版本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="4">
          <mxGeometry x="70" y="330" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="8" value="画像完成后没有强引导到目标&#xa;Alan 当前实际停在这里" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="4">
          <mxGeometry x="40" y="470" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="9" value="再次进入画像页会保留一条&#xa;100% 完整但 ACTIVE 的访谈草稿" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="4">
          <mxGeometry x="40" y="620" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="10" value="2. 目标与计划" style="swimlane;startSize=34;horizontal=0;fillColor=#f5f5f5;strokeColor=#9e9e9e;fontStyle=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="380" y="110" width="420" height="1000" as="geometry" />
        </mxCell>
        <mxCell id="11" value="用户另点一次“让 AI 推荐”&#xa;或直接新建目标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="10">
          <mxGeometry x="100" y="60" width="240" height="70" as="geometry" />
        </mxCell>
