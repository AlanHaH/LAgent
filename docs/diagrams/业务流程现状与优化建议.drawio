          <mxGeometry x="130" y="180" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="13" value="激活目标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="10">
          <mxGeometry x="130" y="290" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="14" value="自动提交规划作业&#xa;QUEUED / RUNNING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="10">
          <mxGeometry x="100" y="400" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="15" value="前端立即提示“已生成方案”&#xa;但后台其实刚排队" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="10">
