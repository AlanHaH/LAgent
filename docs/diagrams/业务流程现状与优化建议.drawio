        <mxCell id="2" value="当前业务主流程" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#173d31;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="3" value="蓝色：用户动作　绿色：正式生效　黄色：异步/待确认　红色：已确认的业务断点" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
