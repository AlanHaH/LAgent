MYSQL_DATABASE=adaptive_learning
MYSQL_USER=learning
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=replace-with-at-least-32-random-characters
VERIFICATION_CODE_PEPPER=replace-with-another-long-random-secret
WEB_PORT=8088
CORS_ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=
# 仅供本地可视化测试使用；不要在生产环境配置固定测试密码。
TEST_STUDENT_LOGIN=
TEST_STUDENT_PASSWORD=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_AUTH_ENABLED=true
MAIL_STARTTLS_ENABLED=true
MAIL_SSL_ENABLED=false
MODEL_ENABLED=true
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
MODEL_SECRET_ENCRYPTION_KEY=replace-with-a-separate-random-secret-at-least-32-characters
MODEL_NAME=deepseek-v4-flash
MODEL_TIMEOUT=PT45S
MODEL_MAX_OUTPUT_TOKENS=1200
MODEL_THINKING=disabled
# Python 侧模型调用超时（秒）：推理模型长输出常超过 60 秒，放宽避免中途掐断
MODEL_TIMEOUT_SECONDS=120
AI_SERVICE_ENABLED=true
AI_SERVICE_BASE_URL=http://127.0.0.1:8090
AI_INTERNAL_TOKEN=replace-with-a-separate-32-character-internal-token
AI_SERVICE_TIMEOUT=PT330S
# Python AI 运行时系统提示词同步：指向 Java 后端根地址（prompt_template 表 ACTIVE 即生效）。
# 留空则禁用同步，回退到 Python 内置常量（离线/测试）。修改提示词并启用新版本后约 TTL 秒内生效。
AI_PROMPT_SYNC_URL=http://127.0.0.1:8080
AI_PROMPT_SYNC_TTL_SECONDS=60
TASK_CHAT_HISTORY_MAX_MESSAGES=400
TASK_CHAT_HISTORY_MAX_CHARACTERS=600000
AI_EMBEDDING_PROVIDER=sentence_transformers
AI_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
AI_EMBEDDING_DEVICE=cpu
AI_ALLOW_HASH_FALLBACK=true
AI_QDRANT_MODE=local
AI_QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=replace-with-a-separate-32-character-qdrant-key
AI_OCR_ENABLED=true
AI_OCR_MAX_FILE_MB=50
AI_OCR_MAX_PAGES=100
AI_OCR_DPI=180
CLAMAV_HOST=
CLAMAV_PORT=3310
ANTIVIRUS_REQUIRED=false
# ---- 微信读书 MCP（图书页）----
# 离线演示模式：返回样例书架 + 自动成功的假二维码，不碰真实账号
WEREAD_MCP_FAKE=true
# weread-mcp 凭据落盘路径（wrk- Key / 扫码 Cookie，仅本机保存）
WEREAD_MCP_CREDENTIALS_PATH=./data/credentials.json
# ai-service 连接 weread-mcp 的地址（本地开发默认 8091）
AI_WEREAD_MCP_URL=http://127.0.0.1:8091/mcp
