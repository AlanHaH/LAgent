{
  "name": "adaptive-learning-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build --config vite.config.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:types": "tsc --noEmit -p e2e/tsconfig.json",
    "test:visual": "playwright test --ui",
    "test:report": "playwright show-report playwright-report"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "dompurify": "^3.2.1",
    "echarts": "^5.5.1",
    "element-plus": "^2.8.7",
    "markdown-it": "^14.1.0",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/dompurify": "^3.0.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "bcryptjs": "^3.0.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.10",
    "vue-tsc": "^2.1.10"
  }
}
